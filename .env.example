# Bu dosyayı kopyala → hosting panelinin "Environment Variables" bölümüne
# aynı isimlerle gerçek değerleri gir. .env dosyasını asla commit etme.

# --- Turso (libSQL) veritabanı ---
# turso db create dilek-agaci        → TURSO_DATABASE_URL için
# turso db tokens create dilek-agaci → TURSO_AUTH_TOKEN için
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- NVIDIA NIM (build.nvidia.com) — içerik moderasyonu ---
# build.nvidia.com üzerinden ücretsiz API anahtarı alınır.
NIM_API_KEY=
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NIM_TIMEOUT_MS=8000

# --- hCaptcha (dashboard.hcaptcha.com) — bot/spam koruması ---
# Site key HTML'e gömülür (gizli değil), secret key sadece sunucuda kalır.
HCAPTCHA_SECRET=
# Frontend'e derleme sırasında geçirilecek public site key (bkz. public/index.html).
HCAPTCHA_SITE_KEY=

# Formun sunulacağı gerçek origin(ler), virgülle ayrılmış.
CORS_ALLOWED_ORIGINS=https://dilekagaci.onrender.com

PORT=3020
